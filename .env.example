# Supabase (client-exposed)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe (client-exposed publishable key only)
VITE_STRIPE_PUBLISHABLE_KEY=

# Stripe (server-only, used by edge functions / API routes — NEVER prefix with VITE_)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# Supabase server
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional email, server-only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@yourdomain.tld

# Platform config
PLATFORM_FEE_PERCENT=10
APP_BASE_URL=http://localhost:5173
